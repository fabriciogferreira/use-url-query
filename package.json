{
	"name": "@fabriciogferreira/use-url-query",
	"version": "0.1.3",
	"publishConfig": {
		"access": "public"
	},
	"private": false,
	"description": "Hook in typescript + Nextjs for Spatie Laravel Query Builder",
	"type": "module",
	"license": "MIT",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"keywords": [
		"react",
		"react-hook",
		"hooks",
		"typescript",
		"nextjs",
		"url",
		"search-params",
		"query-params",
		"querystring",
		"filters",
		"sorting",
		"pagination",
		"query-builder",
		"laravel",
		"spatie"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/fabriciogferreira/use-url-query.git"
	},
	"scripts": {
		"build": "tsc",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:coverage:filter": "vitest run --coverage tests/filter.test.tsx --coverage.include=src/filters.ts --coverage.thresholds.lines=100 --coverage.thresholds.functions=100 --coverage.thresholds.branches=100 --coverage.thresholds.statements=100",
		"playground:dev": "next dev playground --port 3017 --hostname 127.0.0.1",
		"test:browser": "playwright test",
		"prepublishOnly": "bun run build"
	},
	"devDependencies": {
		"@playwright/test": "^1.57.0",
		"@testing-library/react": "^16.3.1",
		"@types/react": "^19.2.7",
		"@vitest/coverage-v8": "^5.1.1",
		"fast-cartesian": "^9.0.1",
		"happy-dom": "^21.0.4",
		"js-combinatorics": "^2.1.2",
		"react": "^19.2.3",
		"react-dom": "^19.2.3",
		"typescript": "^5.9.3",
		"vitest": "^5.1.1",
		"zod": "^4.3.5"
	},
	"dependencies": {
		"@fabriciogferreira/schema-to-query-string": "^0.1.8",
		"next": "^16.1.1",
		"nuqs": "^2.8.7"
	}
}