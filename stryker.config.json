{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"vitest": {
		"configFile": "vitest.config.ts",
		"related": true
	},
	"mutate": [
		"src/**/*.ts",
		"!src/**/*.d.ts",
		"!src/index.ts"
	],
	"ignoreStatic": true,
	"reporters": ["clear-text", "progress", "html"],
	"htmlReporter": {
		"fileName": "reports/mutation/mutation.html"
	},
	"thresholds": {
		"high": 100,
		"low": 100,
		"break": 100
	},
	"concurrency": 2
}
